# =============================================================================
# AgentPay Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- PayPal REST API (Required for payment processing) ---
# Get your credentials at: https://developer.paypal.com
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
# Environment: "sandbox" (recommended for development) or "live" (real money)
PAYPAL_ENVIRONMENT=sandbox

# --- Application URL ---
# Base URL for OAuth redirects and callbacks
APP_URL=http://localhost:5173

# --- Session Security ---
# Secret key for HMAC session token signing (min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_32_character_or_longer_random_secret_here

# --- Supabase (Optional - for persistent transaction storage) ---
# Get your credentials at: https://supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role key - NEVER expose this to the client
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- AI Provider Keys (Optional - for live AI agent execution) ---
# Google Gemini: https://ai.google.dev/gemini-api/docs
GEMINI_API_KEY=your_gemini_api_key_here
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# --- Server Configuration ---
PORT=3001
NODE_ENV=development
# Set to "true" for verbose debug logging
DEBUG=false